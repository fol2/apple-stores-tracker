{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apple-price-tracker",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },

  "routes": [{ "pattern": "apple-price-tracker.eugnel.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/llms.txt"]
  },

  // One planned batch per tick, each sized to fit a single invocation's
  // subrequest allowance. A pass is ~105 batches across 15 markets and both of
  // Apple's stores, so it needs a brisk tick to finish in hours rather than
  // days; at three minutes a pass lands in under six. The worker then idles
  // until the next pass is due -- see SWEEP_INTERVAL_MS.
  "triggers": { "crons": ["*/3 * * * *"] },

  "kv_namespaces": [{ "binding": "PRICES", "id": "47e39bc1784b4a7d8942a7d9fb61c235" }],

  "d1_databases": [
    {
      "binding": "HISTORY",
      "database_name": "price-history",
      "database_id": "64d8055c-e578-4360-869f-8703c783bb4a",
      "migrations_dir": "migrations"
    }
  ]
}
