# Copy to `.env` and fill in. `.env` is gitignored and must stay that way:
# these values are yours, and nothing here should ever print one.
#
# On GitHub Actions the same names come from repository secrets instead
# (Settings -> Secrets and variables -> Actions), so `.env` is for local runs.

# Publishing to Cloudflare. Token needs Workers KV Storage: Edit and D1: Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# eBay Browse API, for the second-hand tab. developer.ebay.com -> Application
# Keys -> Production keyset. App ID is the client id, Cert ID the secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
